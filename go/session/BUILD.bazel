load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "session",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "go.atoms.co/lib/net/session/go/session",
    visibility = ["//visibility:public"],
    deps = [
        "//proto/atoms/lib/net/session:session_go_proto",
        "@co_atoms_go_iox//:iox",
        "@co_atoms_go_lib//chanx",
        "@co_atoms_go_lib//encoding/protox",
        "@co_atoms_go_lib//log",
        "@co_atoms_go_lib//metrics",
        "@co_atoms_go_lib_net_location//go/location",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "session_test",
    srcs = glob(["*_test.go"]),
    deps = [
        ":session",
        "@co_atoms_go_lib//testing/assertx",
        "@co_atoms_go_lib//testing/requirex",
        "@co_atoms_go_lib//testing/synctestx",
        "@co_atoms_go_lib_net_location//go/location",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
